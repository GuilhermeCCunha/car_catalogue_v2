<h1 class="default-heading"><%= t('titles.profile') %></h1>
<div class="d-flex flex-column align-items-center">
  <p class="fs-3"><%= t('.welcome_email', email: current_user.email) %></p>
  <% if current_user&.admin? %>
    <p class="fs-4"><%= t('.admin_access_text') %></p>
    <%= link_to t('titles.dashboard'), admin_dashboard_path, class:"btn btn-primary btn-lg mb-3", role:"button" %>
  <% end %>
  <%= link_to t('links.sign_out'), destroy_user_session_path, method: :delete, data: { turbo_method: :delete } %>
</div>
